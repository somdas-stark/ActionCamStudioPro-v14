<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action Cam Studio Pro v1.4.0"
            android:textColor="#F1F5F9"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHwStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="#111827"
            android:padding="7dp"
            android:text="RAM: --/-- GB | Temp: --°C | Free: -- GB | GPU: OpenGL ES 3.0"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Card 1: Interactive Split-Screen Compare (RAW Input vs ActionCam Studio v3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131A2A"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSelectedVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Select Raw .MOV / .MP4 Clip"
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSplitBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="RAW 50% | STUDIO v3"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPreviewFrame"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="8dp"
                android:background="#070A12"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAW"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbSplitCompare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDIO v3"
                    android:textColor="#F97316"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAiSceneResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1E1B4B"
                android:padding="8dp"
                android:text="AI Scene: Pick a video then tap AI Auto-Tune"
                android:textColor="#DDD6FE"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickVideo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#3B82F6"
                    android:text="Pick Video"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnAiAutoTune"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#8B5CF6"
                    android:text="AI Auto-Tune"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: True Motion Cinematic Teal-Orange Grade & Stepper Tuning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131A2A"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. Cinematic Grade &amp; Tuning"
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnResetSliders"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#1E293B"
                    android:text="Reset"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spColorGrade"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#0F172A"
                android:layout_marginBottom="8dp" />

            <!-- Brightness -->
            <TextView android:id="@+id/lblBrightness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Brightness: 0" android:textColor="#CBD5E1" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnBrMinus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="-" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
                <SeekBar android:id="@+id/sbBrightness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="200" android:progress="100"/>
                <Button android:id="@+id/btnBrPlus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="+" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Contrast -->
            <TextView android:id="@+id/lblContrast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contrast: 0" android:textColor="#CBD5E1" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnCoMinus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="-" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
                <SeekBar android:id="@+id/sbContrast" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="200" android:progress="100"/>
                <Button android:id="@+id/btnCoPlus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="+" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Highlights -->
            <TextView android:id="@+id/lblHighlights" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Highlights (Glare): 0" android:textColor="#CBD5E1" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnHiMinus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="-" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
                <SeekBar android:id="@+id/sbHighlights" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="200" android:progress="100"/>
                <Button android:id="@+id/btnHiPlus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="+" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Shadows -->
            <TextView android:id="@+id/lblShadows" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shadows (Cabin): 0" android:textColor="#CBD5E1" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnShMinus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="-" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
                <SeekBar android:id="@+id/sbShadows" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="200" android:progress="100"/>
                <Button android:id="@+id/btnShPlus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="+" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Saturation -->
            <TextView android:id="@+id/lblSaturation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saturation: 0" android:textColor="#CBD5E1" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnSaMinus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="-" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
                <SeekBar android:id="@+id/sbSaturation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="200" android:progress="100"/>
                <Button android:id="@+id/btnSaPlus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="+" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Sharpness / Clarity -->
            <TextView android:id="@+id/lblSharpness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sharpness / Clarity (0-100): 0" android:textColor="#CBD5E1" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/btnSpMinus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="-" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
                <SeekBar android:id="@+id/sbSharpness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" android:progress="0"/>
                <Button android:id="@+id/btnSpPlus" android:layout_width="44dp" android:layout_height="38dp" android:padding="0dp" android:text="+" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#1E293B" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Audio / BGM Mixer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131A2A"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Audio &amp; BGM Track Mixer"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnPickAudio"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:backgroundTint="#1E293B"
                android:text="Select MP3 / Audio Track from Phone"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSelectedAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BGM: None (Original Video Audio Only)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <CheckBox
                android:id="@+id/cbMuteOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace Original Video Audio with Selected BGM"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card 4: Framing, Resolution, FPS, Studio Bitrate & Render + Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131A2A"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Export Settings &amp; Studio Bitrate Quality"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner android:id="@+id/spAspectRatio" android:layout_width="match_parent" android:layout_height="42dp" android:background="#0F172A" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spResolution" android:layout_width="match_parent" android:layout_height="42dp" android:background="#0F172A" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spFps" android:layout_width="match_parent" android:layout_height="42dp" android:background="#0F172A" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spBitrate" android:layout_width="match_parent" android:layout_height="42dp" android:background="#0F172A" android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRender"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="2.2"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#F97316"
                    android:text="RENDER FINAL EDIT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCancelRender"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DC2626"
                    android:text="CANCEL"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressRender"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvRenderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Status: Idle | Saves to Movies/ActionCamStudio"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
